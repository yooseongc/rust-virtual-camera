{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rust Virtual Camera",
  "version": "0.3.1",
  "identifier": "dev.rustvirtualcamera.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Rust Virtual Camera",
        "width": 1080,
        "height": 820,
        "minWidth": 920,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "resources": {
      "../native/mfvcam-manager/dist/mfvcam_manager.exe": "mfvcam/mfvcam_manager.exe",
      "../native/windows-camera-reference/Samples/VirtualCamera/x64/Release/VirtualCameraMediaSource.dll": "mfvcam/RustVirtualCameraMediaSource.dll",
      "../native/dshow-manager/dist/x64/dshow_manager.exe": "dshow/dshow_manager64.exe",
      "../native/dshow-manager/dist/Win32/dshow_manager.exe": "dshow/dshow_manager32.exe",
      "../native/softcam/x64/Release/softcam.dll": "dshow/softcam64.dll",
      "../native/softcam/Win32/Release/softcam.dll": "dshow/softcam32.dll",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
